# Algoryx Web Crawler & Data Extraction Engine - Environment Configuration

# User-Agent header sent with HTTP requests
CRAWLER_USER_AGENT=AlgoryxBot/1.0 (+https://www.algoryx.in; internship-task-4)

# Network timeouts (in seconds)
REQUEST_TIMEOUT=15.0

# Maximum retry attempts on network failures / 5xx responses
MAX_RETRIES=3

# Politeness crawl delay between requests to the same domain (in seconds)
CRAWL_DELAY=1.0

# Respect robots.txt directives (true/false)
RESPECT_ROBOTS=true

# Default crawl traversal limits
MAX_DEPTH=2
MAX_PAGES=30
MAX_CONCURRENCY=3

# Output directory for exported datasets (JSON, CSV)
OUTPUT_DIRECTORY=data

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FILE=logs/crawler.log
